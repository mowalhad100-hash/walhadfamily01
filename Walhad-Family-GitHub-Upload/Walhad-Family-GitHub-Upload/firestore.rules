rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  function verified(){return signed() && request.auth.token.email_verified == true;}
  function member(id){return verified() && request.auth.uid in get(/databases/$(database)/documents/chats/$(id)).data.members;}
  function notBlocked(id){
   let members=get(/databases/$(database)/documents/chats/$(id)).data.members;
   let other=members[0] == request.auth.uid ? members[1] : members[0];
   return !exists(/databases/$(database)/documents/users/$(other)/blocks/$(request.auth.uid)) && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocks/$(other));
  }
  match /users/{uid} {
   match /blocks/{other} {allow read: if verified() && request.auth.uid == uid;}

   allow read: if verified();
   allow create: if signed() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['displayName','photoURL','bio','online','lastSeen'])
    && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 60
    && request.resource.data.photoURL == '' && request.resource.data.bio == '' && request.resource.data.online == false && request.resource.data.lastSeen == request.time;
   allow update: if verified() && request.auth.uid == uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','bio','online','lastSeen'])
    && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 60
    && request.resource.data.bio is string && request.resource.data.bio.size() <= 160
    && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048
    && (request.resource.data.photoURL == '' || request.resource.data.photoURL.matches('https://firebasestorage[.]googleapis[.]com/.*'))
    && request.resource.data.online is bool && request.resource.data.lastSeen == request.time;
   match /devices/{device} {
    allow read,delete: if signed() && request.auth.uid == uid;
    allow create,update: if verified() && request.auth.uid == uid
     && request.resource.data.keys().hasOnly(['token','updatedAt'])
     && request.resource.data.token is string && request.resource.data.token.size() < 300 && request.resource.data.token.matches('(ExponentPushToken|ExpoPushToken)\\[.*\\]')
     && request.resource.data.updatedAt == request.time;
   }
  }
  match /chats/{id} {
   allow read: if verified() && request.auth.uid in resource.data.members;
   allow create: if verified() && request.resource.data.keys().hasOnly(['members'])
    && request.resource.data.members is list && request.resource.data.members.size() == 2
    && request.resource.data.members[0] is string && request.resource.data.members[1] is string
    && request.resource.data.members[0] < request.resource.data.members[1]
    && request.auth.uid in request.resource.data.members
    && id == request.resource.data.members[0] + '_' + request.resource.data.members[1]
    && exists(/databases/$(database)/documents/users/$(request.resource.data.members[0]))
    && exists(/databases/$(database)/documents/users/$(request.resource.data.members[1]));
   allow update: if verified() && request.auth.uid in resource.data.members && request.resource.data == resource.data;
   match /messages/{message} {
    allow read: if member(id);
    allow create: if member(id) && notBlocked(id) && request.resource.data.keys().hasOnly(['senderId','text','createdAt'])
     && request.resource.data.senderId == request.auth.uid && request.resource.data.text is string
     && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000
     && request.resource.data.createdAt == request.time;
   }
  }
  match /calls/{id} { allow read: if verified() && request.auth.uid in resource.data.members; }
 }
}
