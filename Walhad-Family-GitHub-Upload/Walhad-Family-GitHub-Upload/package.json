{
  "name": "walhad-family-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/model.test.mjs",
    "doctor": "npx expo-doctor",
    "test:rules": "firebase emulators:exec --project demo-walhad --only firestore,storage \"node --test --test-concurrency=1 tests/*.rules.test.mjs\"",
    "bundle": "expo export --platform android --platform ios",
    "test:dependencies": "node --test tests/dependency-compat.test.mjs"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^13.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@stream-io/react-native-webrtc": "145.4.1",
    "@stream-io/video-react-native-sdk": "1.46.2",
    "expo": "~54.0.37",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.10",
    "expo-notifications": "~0.32.16",
    "expo-system-ui": "~6.0.9",
    "firebase": "^12.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "~19.1.10",
    "firebase-tools": "^14.0.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "tar": "^7.5.22",
    "@grpc/grpc-js": "^1.14.6",
    "@expo/metro-config": {
      "postcss": "8.5.30"
    },
    "uuid@>=7 <10": "11.1.1",
    "get-uri": {
      "basic-ftp": "6.2.3"
    }
  }
}
